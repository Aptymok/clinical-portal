# Example Postgres URL for local development with Docker Compose
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/clinical_portal"

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me

# 64 hex chars = 32-byte AES-256 key.
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Optional local/demo seed credentials. Never commit real passwords.
SEED_ADMIN_PASSWORD=
SEED_DOCTOR_PASSWORD=

# Public canonical site URL used by OAuth callbacks, webhooks, sitemap and metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Canonical provider identity used across synchronized calendars.
CALENDAR_PROVIDER_REF=dr-guillermo

# Internal normalized calendar intake / availability gate.
CALENDAR_SYNC_SECRET=

# Google Calendar OAuth / API.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_ID=primary

# Doctoralia / Docplanner Integrations API.
DOCPLANNER_DOMAIN=doctoralia.mx
DOCPLANNER_CLIENT_ID=
DOCPLANNER_CLIENT_SECRET=
DOCPLANNER_FACILITY_ID=
DOCPLANNER_DOCTOR_ID=
DOCPLANNER_ADDRESS_ID=
DOCPLANNER_WEBHOOK_SECRET=

# Third calendar generic webhook adapter.
THIRD_CALENDAR_WRITE_URL=
THIRD_CALENDAR_WEBHOOK_SECRET=
